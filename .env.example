# ── Servidor ────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=development          # development | production | test

# ── Base de datos (PostgreSQL) ───────────────────────────────────────
# Opción A — Supabase (recomendado): cadena del Session Pooler (IPv4).
# Dashboard Supabase → Connect → Session pooler
# DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres

# Opción B — Postgres local (solo se usa si DATABASE_URL está vacío)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=home_db
DB_USER=postgres
DB_PASSWORD=                  # REQUERIDO si no usas DATABASE_URL

# ── Supabase API (Storage, Auth) ─────────────────────────────────────
# SUPABASE_URL=https://<project-ref>.supabase.co
# SUPABASE_KEY=                # clave "secret" (sb_secret_...), NO la "publishable" — necesaria para subir a Storage sin RLS
# SUPABASE_PHOTOS_BUCKET=project-photos  # bucket público para fotos de proyectos (antes/durante/después)

# ── Redis ────────────────────────────────────────────────────────────
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=               # Dejar vacío si no tiene contraseña

# ── JWT — REQUERIDOS, mínimo 32 caracteres cada uno ─────────────────
JWT_SECRET=                   # Genera con: openssl rand -hex 32
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=           # Debe ser DIFERENTE a JWT_SECRET
JWT_REFRESH_EXPIRES_IN=30d

# ── CORS ─────────────────────────────────────────────────────────────
# En producción: lista separada por comas (web + app)
# FRONTEND_URL=https://tuapp.com,https://admin.tuapp.com
FRONTEND_URL=http://localhost:5173

# URL pública del backend (para el enlace de verificación de correo).
# En producción: https://api.tuapp.com
BACKEND_URL=http://localhost:3000

# ── Email (SMTP) — correos transaccionales (reset password, verificación) ──
# Sin estas variables, los correos NO se envían: se registran en consola
# (útil en desarrollo). En producción son obligatorias para que el flujo
# de "olvidé mi contraseña" y la verificación de cuenta funcionen.
# Ejemplos de proveedor: SendGrid (smtp.sendgrid.net:587, user "apikey"),
# Mailgun, Amazon SES, Resend, o un SMTP propio.
SMTP_HOST=                   # ej: smtp.sendgrid.net
SMTP_PORT=587                # 587 (STARTTLS) o 465 (SSL)
SMTP_SECURE=                 # 'true' fuerza SSL; vacío = auto según el puerto
SMTP_USER=                   # usuario SMTP
SMTP_PASS=                   # contraseña / API key
EMAIL_FROM=HOME <no-reply@tuapp.com>

# ── OAuth ────────────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=                # Cliente "Web" (valida tokens de Android/web)
GOOGLE_IOS_CLIENT_ID=            # Cliente "iOS" (valida tokens de la app iOS)

# Apple Sign-In — bundle id / services id (aud del identityToken).
# Varios permitidos separados por comas (app iOS + Services ID web).
APPLE_CLIENT_ID=                 # ej: com.samuelgomez.homeapp

# ── Wompi (pagos) ──────────────────────────────────────────────────────
WOMPI_API_URL=https://sandbox.wompi.co/v1   # producción: https://production.wompi.co/v1
WOMPI_PUBLIC_KEY=                # pub_test_... / pub_prod_...
WOMPI_PRIVATE_KEY=               # prv_test_... / prv_prod_... — NUNCA exponer al cliente
WOMPI_EVENTS_SECRET=             # para verificar la firma de los webhooks
WOMPI_INTEGRITY_SECRET=          # para firmar transacciones desde el backend
# Horas de espera tras `completado` antes de que un payout sea aprobable
# (ventana para disputas/calificación) — acordado en rango 48-72h.
PAYOUT_WAIT_HOURS=60

# ── Wompi Payouts / "Pagos a Terceros" (producto SEPARADO de lo de arriba —
# dominio, llaves y secreto de webhook propios, requiere activación aparte
# con el representante legal, 2-5 días hábiles) ─────────────────────────
WOMPI_PAYOUTS_API_URL=https://api.payouts.wompi.co/v1
WOMPI_PAYOUTS_API_KEY=            # header x-api-key
WOMPI_PAYOUTS_USER_PRINCIPAL_ID=  # header user-principal-id
WOMPI_PAYOUTS_EVENTS_SECRET=      # para verificar la firma del webhook de payouts
WOMPI_PAYOUTS_ACCOUNT_ID=         # cuenta de origen de HOME en Wompi (GET /accounts)
