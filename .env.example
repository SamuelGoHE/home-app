# ── Servidor ────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=development          # development | production | test

# ── Base de datos (PostgreSQL) ───────────────────────────────────────
# Opción A — Supabase (recomendado): cadena del Session Pooler (IPv4).
# Dashboard Supabase → Connect → Session pooler
# DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres

# Opción B — Postgres local (solo se usa si DATABASE_URL está vacío)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=home_db
DB_USER=postgres
DB_PASSWORD=                  # REQUERIDO si no usas DATABASE_URL

# ── Supabase API (Storage, Auth) ─────────────────────────────────────
# SUPABASE_URL=https://<project-ref>.supabase.co
# SUPABASE_KEY=                # clave "secret" (sb_secret_...), NO la "publishable" — necesaria para subir a Storage sin RLS
# SUPABASE_PHOTOS_BUCKET=project-photos  # bucket público para fotos de proyectos (antes/durante/después)

# ── Redis ────────────────────────────────────────────────────────────
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=               # Dejar vacío si no tiene contraseña

# ── JWT — REQUERIDOS, mínimo 32 caracteres cada uno ─────────────────
JWT_SECRET=                   # Genera con: openssl rand -hex 32
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=           # Debe ser DIFERENTE a JWT_SECRET
JWT_REFRESH_EXPIRES_IN=30d

# ── CORS ─────────────────────────────────────────────────────────────
# En producción: lista separada por comas (web + app)
# FRONTEND_URL=https://tuapp.com,https://admin.tuapp.com
FRONTEND_URL=http://localhost:5173

# ── OAuth ────────────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=                # Cliente "Web" (valida tokens de Android/web)
GOOGLE_IOS_CLIENT_ID=            # Cliente "iOS" (valida tokens de la app iOS)

# Apple Sign-In — bundle id / services id (aud del identityToken).
# Varios permitidos separados por comas (app iOS + Services ID web).
APPLE_CLIENT_ID=                 # ej: com.samuelgomez.homeapp
